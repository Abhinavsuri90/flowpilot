{
  "name": "flowpilot",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Shareable, versioned CSV report recipes for teams",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "tsx scripts/seed.ts --if-empty",
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "seed": "tsx scripts/seed.ts",
    "seed:reset": "tsx scripts/seed.ts --reset",
    "check:model": "tsx scripts/check-model.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "eval:model": "tsx scripts/eval-model.ts",
    "smoke": "tsx scripts/smoke.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.39",
    "@tanstack/react-start": "^1.168.58",
    "@tanstack/react-table": "^9.2.4",
    "better-sqlite3": "^13.0.3",
    "lucide-react": "^1.48.0",
    "nitro": "^3.0.260903-beta",
    "papaparse": "^5.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^25.9.8",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  }
}
