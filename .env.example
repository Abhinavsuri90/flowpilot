DATABASE_PATH=./data/flowpilot.db
SEED_PASSWORD=flowpilot-demo

# Accounts
# DEMO_MODE=true             # one-click demo accounts on the sign-in page (default: on in development, off in production)
# REGISTRATION=open          # open | invite-only | closed
# APP_URL=https://flowpilot.example.com   # public URL used in emailed links (default: the request's origin)
# TRUST_PROXY=false          # true behind Caddy/nginx (the address the proxy appended to X-Forwarded-For), fly on Fly.io (Fly-Client-IP); rate limits use it

# Email (password resets, invitations). Without these, emails are written to the server log.
# RESEND_API_KEY=
# MAIL_FROM=FlowPilot <noreply@your-domain.com>

# AI drafting is optional: the app works without any key (manual editing; saved recipes always run).
# MODEL_PROVIDER=openrouter  # anthropic | openai | openrouter (inferred from whichever key is set)
# MODEL_NAME=openai/gpt-6-luna   # defaults: gpt-5 (openai) · openai/gpt-6-luna (openrouter); required for anthropic
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_BASE_URL=        # optional overrides (a proxy, or the e2e mock model)
# OPENAI_BASE_URL=
# OPENROUTER_BASE_URL=
